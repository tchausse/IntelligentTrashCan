<?xml version="1.0"?>
<!--
  A minimal walled room, 5 m x 4 m, used until the shared house world from
  home-robot-common is integrated. The robot spawns at its center facing +x;
  the east wall is 2.5 m ahead.
-->
<sdf version="1.9">
  <world name="minimal_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.72 0.66 0.58 1</ambient>
            <diffuse>0.72 0.66 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0.0 2.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.2 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.2 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.78 1</ambient>
            <diffuse>0.85 0.83 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0.0 -2.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.2 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.2 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.78 1</ambient>
            <diffuse>0.85 0.83 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>2.55 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.78 1</ambient>
            <diffuse>0.85 0.83 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-2.55 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.78 1</ambient>
            <diffuse>0.85 0.83 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="cabinet">
      <static>true</static>
      <pose>1.6 1.4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.8</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.24 1</ambient>
            <diffuse>0.55 0.38 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
