<?xml version="1.0"?>
<!-- ros2_control interfaces of the drive wheels, simulated by gz_ros2_control. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="trashcan_ros2_control" params="controllers_file">
    <ros2_control name="TrashcanDrive" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:macro name="wheel_interfaces" params="joint">
        <joint name="${joint}">
          <command_interface name="velocity">
            <param name="min">-15.0</param>
            <param name="max">15.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:wheel_interfaces joint="left_wheel_joint"/>
      <xacro:wheel_interfaces joint="right_wheel_joint"/>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
