<?xml version="1.0"?>
<!--
  Intelligent trash can robot: a round, low differential-drive base carrying an
  open-top bin.

  Arguments:
    controllers_file  ros2_control parameters loaded by gz_ros2_control.
-->
<robot name="trashcan" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_file"
             default="$(find trashcan_description)/config/trashcan_controllers.yaml"/>

  <xacro:include filename="$(find trashcan_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find trashcan_description)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find trashcan_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find trashcan_description)/urdf/base.xacro"/>
  <xacro:include filename="$(find trashcan_description)/urdf/bin.xacro"/>
  <xacro:include filename="$(find trashcan_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find trashcan_description)/urdf/ros2_control.xacro"/>

  <xacro:trashcan_ros2_control controllers_file="$(arg controllers_file)"/>

</robot>
